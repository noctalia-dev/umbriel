#!/bin/sh

drs=
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] &&
   command -v dbus-run-session >/dev/null 2>&1; then
    drs=dbus-run-session
fi

if { [ -n "${MANAGERPID:-}" ] && [ "${SYSTEMD_EXEC_PID:-}" = "$$" ]; } ||
   [ -n "${UMBRIEL_DINIT_READY_FD:-}" ]; then
  exec ${drs} @UMBRIEL_EXECUTABLE@ "$@"
fi

login_reentry=false
if [ "${UMBRIEL_LOGIN_REENTRY:-}" = 1 ]; then
  login_reentry=true
  unset UMBRIEL_LOGIN_REENTRY
  unset WAYLAND_DISPLAY WAYLAND_SOCKET DISPLAY UMBRIEL_SOCKET \
    XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
fi

if [ "$login_reentry" = false ]; then
  if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${WAYLAND_SOCKET:-}" ] ||
    [ -n "${DISPLAY:-}" ]; then
    exec ${drs} @UMBRIEL_EXECUTABLE@ "$@"
  fi

  login_shell_kind=
  if [ -n "${SHELL:-}" ] && [ -x "$SHELL" ] && [ -r /etc/shells ]; then
    case "${SHELL##*/}" in
      fish) login_shell_kind=fish ;;
      ash | bash | dash | ksh | ksh93 | mksh | oksh | sh | yash | zsh)
        login_shell_kind=bourne
        ;;
    esac
    if [ -n "$login_shell_kind" ]; then
      shell_listed=false
      while IFS= read -r candidate; do
        if [ "$candidate" = "$SHELL" ]; then
          shell_listed=true
          break
        fi
      done < /etc/shells
      if [ "$shell_listed" = false ]; then
        login_shell_kind=
      fi
    fi
  fi

  # A display manager starts the session launcher directly. Enter the user's
  # shell once so its noninteractive login profile can extend the environment.
  case "$login_shell_kind" in
    fish)
      UMBRIEL_LOGIN_REENTRY=1 exec "$SHELL" -l -c 'exec $argv' "$0" "$@"
      ;;
    bourne)
      UMBRIEL_LOGIN_REENTRY=1 exec "$SHELL" -l -c 'exec "$@"' "$SHELL" "$0" "$@"
      ;;
  esac
fi

session_environment_names() {
  awk 'BEGIN {
    for (name in ENVIRON) {
      if (name != "AWKPATH" && name != "AWKLIBPATH" &&
          name ~ /^[A-Za-z_][A-Za-z0-9_]*$/)
        print name
    }
  }' </dev/null
}

dinit_available() {
  command -v dinitctl >/dev/null 2>&1 &&
    dinitctl --user --quiet list >/dev/null 2>&1
}
session_manager=direct
if [ -n "${DINIT_SOCKET_PATH:-}" ] && dinit_available; then
  session_manager=dinit
elif command -v systemctl >/dev/null 2>&1 &&
     systemctl --user show-environment >/dev/null 2>&1; then
  session_manager=systemd
elif dinit_available; then
  session_manager=dinit
fi

if [ "$session_manager" = dinit ]; then
  # Explicit options and commands retain direct launch semantics. Service
  # configuration supplies options for a supervised compositor.
  if [ "$#" -ne 0 ]; then
    exec ${drs} @UMBRIEL_EXECUTABLE@ "$@"
  fi
  case "${DINIT_SOCKET_PATH:-}" in
    '' | /*) ;;
    *) DINIT_SOCKET_PATH="$(pwd)/$DINIT_SOCKET_PATH"; export DINIT_SOCKET_PATH ;;
  esac
  if dinitctl --user --quiet is-started umbriel 2>/dev/null; then
    echo "An Umbriel session is already running." >&2
    exit 1
  fi
  dinit_wait_pid=
  cleanup_dinit_session() {
    umbriel_status=$?
    trap '' HUP INT TERM
    trap - 0
    if [ -n "$dinit_wait_pid" ]; then
      kill "$dinit_wait_pid" 2>/dev/null || :
      wait "$dinit_wait_pid" 2>/dev/null || :
    fi
    dinitctl --user --quiet stop --force --ignore-unstarted umbriel || :
    dinitctl --user --quiet stop --force --ignore-unstarted umbriel-session || :
    dinitctl --user --quiet unsetenv WAYLAND_DISPLAY WAYLAND_SOCKET DISPLAY \
      XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE XCURSOR_THEME \
      XCURSOR_SIZE UMBRIEL_SOCKET || :
    if command -v dbus-update-activation-environment >/dev/null 2>&1; then
      dbus-update-activation-environment WAYLAND_DISPLAY= DISPLAY= UMBRIEL_SOCKET= \
        XDG_CURRENT_DESKTOP= XDG_SESSION_DESKTOP= XDG_SESSION_TYPE= XCURSOR_THEME= XCURSOR_SIZE= || :
    fi
    exit "$umbriel_status"
  }
  trap cleanup_dinit_session 0
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  unset WAYLAND_DISPLAY WAYLAND_SOCKET DISPLAY UMBRIEL_SOCKET \
    XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
  dinitctl --user --quiet unsetenv WAYLAND_DISPLAY WAYLAND_SOCKET DISPLAY \
    XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE UMBRIEL_SOCKET || exit 1
  session_environment_names | xargs -r dinitctl --user --quiet setenv || exit 1
  if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    session_environment_names | xargs -r dbus-update-activation-environment || exit 1
  fi
  dinitctl --user --quiet start umbriel &
  dinit_wait_pid=$!
  wait "$dinit_wait_pid"
  umbriel_status=$?
  dinit_wait_pid=
  if [ "$umbriel_status" -ne 0 ]; then exit "$umbriel_status"; fi
  dinitctl --user --quiet start umbriel-session &
  dinit_wait_pid=$!
  wait "$dinit_wait_pid"
  umbriel_status=$?
  dinit_wait_pid=
  if [ "$umbriel_status" -ne 0 ]; then exit "$umbriel_status"; fi
  # Query current state so a stop between startup and observation cannot be missed.
  while dinitctl --user --quiet is-started umbriel &&
        dinitctl --user --quiet is-started umbriel-session; do
    sleep 1 &
    dinit_wait_pid=$!
    wait "$dinit_wait_pid"
    dinit_wait_pid=
  done
  if dinitctl --user --quiet is-failed umbriel ||
     dinitctl --user --quiet is-failed umbriel-session ||
     ! dinitctl --user --quiet list >/dev/null 2>&1; then
    exit 1
  fi
  exit 0
fi

if [ "$session_manager" = direct ]; then
  exec ${drs} @UMBRIEL_EXECUTABLE@ "$@"
fi
if systemctl --user --quiet is-active umbriel.service; then
  echo "An Umbriel session is already running." >&2
  exit 1
fi

systemctl --user reset-failed
systemctl --user unset-environment WAYLAND_DISPLAY WAYLAND_SOCKET DISPLAY \
  XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE UMBRIEL_SOCKET
# Import the login-profile environment before starting the managed session.
session_environment_names | xargs -r systemctl --user import-environment
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  session_environment_names | xargs -r dbus-update-activation-environment
fi

cleanup_session() {
  umbriel_status=$?
  trap '' HUP INT TERM
  trap - 0
  # Reap the start client before shutdown so it cannot submit a later start.
  if [ "$session_wait_done" = false ] && [ -n "$!" ]; then
    kill "$!" 2>/dev/null || :
    wait "$!" 2>/dev/null || :
  fi

  systemctl --user start --job-mode=replace-irreversibly umbriel-shutdown.target
  systemctl --user unset-environment WAYLAND_DISPLAY WAYLAND_SOCKET DISPLAY \
    XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE XCURSOR_THEME \
    XCURSOR_SIZE UMBRIEL_SOCKET
  exit "$umbriel_status"
}

session_wait_done=false
trap cleanup_session 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

systemctl --user --wait start umbriel.service &
wait "$!"
umbriel_status=$?
session_wait_done=true
exit "$umbriel_status"
